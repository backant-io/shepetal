#!/bin/bash
# Installer preinstall: quit a running Shepetal so its bundle can be replaced. Runs as root; the
# quit is sent as the logged-in user, the normal way (like its menu's Quit).
DRY=0; [ -e "$(dirname "$0")/dry-run" ] && DRY=1
USER_NAME=$(stat -f %Su /dev/console)
USER_ID=$(id -u "$USER_NAME")
as_user() {
  if [ "$DRY" = 1 ]; then echo "dry-run as $USER_NAME: $*"; return 0; fi
  if [ "$(id -u)" = 0 ]; then launchctl asuser "$USER_ID" sudo -u "$USER_NAME" "$@"; else "$@"; fi
}
APP="$2/Shepetal.app"
# The crash watchdog first, even with the app not running (after a crash it may be about to open it
# again), so nothing opens the old app during the install.
[ "$DRY" = 1 ] || pkill -f "^$APP/Contents/MacOS/Shepetal --watchdog" || true
if pgrep -qf "^$APP/Contents/MacOS/Shepetal"; then
  as_user osascript -e 'quit app "Shepetal"' || true
  for _ in $(seq 1 40); do pgrep -qf "^$APP/Contents/MacOS/Shepetal" || break; sleep 0.25; done
  [ "$DRY" = 1 ] || pkill -f "^$APP/Contents/MacOS/Shepetal" || true
fi
exit 0
